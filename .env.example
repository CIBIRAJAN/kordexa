# EduOrchestrate — Local Environment Configuration Example
# Copy this file to .env.local to configure real SMTP email delivery.
# DO NOT commit .env.local to version control.

# SMTP Server Settings (Required for real email delivery via `send-today`)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=your-email@gmail.com

# Optional API Keys (For enhanced search link resolution)
# If unset, EduOrchestrate automatically falls back to web search URLs without failing.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here
# GITHUB_TOKEN=your_github_personal_access_token_here

# Execution Flags
# Set to 1 to force offline link resolution (network-free testing)
# EDUORCHESTRATE_OFFLINE=1

